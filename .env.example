# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# Application ID from the same page → General Information
DISCORD_CLIENT_ID=
# Optional: guild ID for instant slash-command registration during development.
# Leave empty in production so commands deploy globally (takes up to 1 hour).
DISCORD_DEV_GUILD_ID=

# ─── Lavalink ─────────────────────────────────────────────────────────────────
# Host is the compose service name; use 'localhost' only when running the bot
# outside Docker against a locally exposed Lavalink.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ─── Spotify ──────────────────────────────────────────────────────────────────
# From https://developer.spotify.com/dashboard (free, no approval needed).
# Spotify audio is DRM-protected: these credentials only resolve track metadata,
# which is then matched and played from YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── YouTube (the fix for "Sign in to confirm you're not a bot") ───────────────
# Leave EMPTY on first run. Lavalink prints a device code to its logs — visit
# https://google.com/device and authorize with a BURNER Google account, never
# your primary. Copy the emitted refresh token here. See README for details.
YT_REFRESH_TOKEN=

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Minutes the bot stays in an empty or idle voice channel before disconnecting.
IDLE_TIMEOUT_MINUTES=5
