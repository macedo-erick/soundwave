DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Empty deploys commands globally, which takes up to an hour.
DISCORD_DEV_GUILD_ID=

LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Leave empty on first run; Lavalink prints a device code to its logs. See README.
YT_REFRESH_TOKEN=

# Empty is intentional: yt-cipher is not published outside the compose network.
YT_CIPHER_PASSWORD=
# Empty uses the container. Override to point at an external cipher server.
YT_CIPHER_URL=

NODE_ENV=development
LOG_LEVEL=debug
IDLE_TIMEOUT_MINUTES=5
