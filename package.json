{
  "name": "soundwave",
  "version": "1.0.0",
  "description": "A Discord music bot supporting YouTube and Spotify, powered by Lavalink.",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "lavalink"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "14.27.0",
    "lavalink-client": "2.10.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
